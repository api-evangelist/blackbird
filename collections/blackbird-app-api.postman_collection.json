            "description": {
              "content": "Returns the calling application's own record, resolved from the\nAPI key — including its `flynet_merchant_id`, `allowed_scopes`, and\nowning account. Use it to look up your `flynet_merchant_id` for\npayment-intent creation without waiting on the onboarding email.\nRequires the `read:app` scope; API-key auth only.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "app"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "X-API-Key"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            }
