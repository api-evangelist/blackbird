      },
      "item": [
        {
          "id": "ab0fadb7-8489-4b01-8e58-e32543dae2bc",
          "name": "List check-ins",
          "request": {
            "name": "List check-ins",
            "description": {
              "content": "Returns paginated check-ins for a restaurant or location — an\nanonymized venue activity feed for dashboards, heatmaps, and\nrecent-visit displays. Responses carry no member identity (see the\ncheck-in schema). Filters — `[restaurant, location, created_after,\ncreated_before]` — are optional and AND together; a bare unfiltered\nlist returns the full set. For the authenticated member's own\nhistory, use `GET /users/me/check_ins`.\n\nUnknown query parameters are silently ignored. A typo in a filter\nname is treated as no filter supplied, so you get the full\nunfiltered set rather than an error.\n\nAuth: API key in `X-API-Key`, minted with the `read:checkins` scope —\nno member token needed. (A member's own history at\n`GET /users/me/check_ins` uses their OAuth token instead.)\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "check_ins"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "restaurant",
                  "value": "<uuid>",
                  "description": "Restaurant UUID — every location of this brand."
                },
                {
                  "disabled": false,
                  "key": "location",
                  "value": "<uuid>",
                  "description": "Location UUID — one specific venue."
                },
                {
                  "disabled": false,
                  "key": "created_after",
                  "value": "<dateTime>",
                  "description": "ISO 8601 timestamp. Epoch seconds are rejected."
                },
                {
                  "disabled": false,
                  "key": "created_before",
                  "value": "<dateTime>",
                  "description": "ISO 8601 timestamp. Epoch seconds are rejected."
                },
                {
                  "disabled": false,
                  "key": "sort_order",
                  "value": "desc"
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "0",
                  "description": "Zero-indexed page number."
                },
                {
                  "disabled": false,
                  "key": "page_size",
                  "value": "50",
                  "description": "Items per page. Default `50`."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "X-API-Key"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            }
          },
