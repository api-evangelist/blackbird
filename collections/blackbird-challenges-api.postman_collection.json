                  "disabled": false,
                  "key": "restaurant",
                  "value": "<uuid>",
                  "description": "(Required) Restaurant UUID to list challenges for."
                },
                {
                  "disabled": false,
                  "key": "location",
                  "value": "<uuid>",
                  "description": "Optional location UUID to filter by."
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "0",
                  "description": "Zero-indexed page number."
                },
                {
                  "disabled": false,
                  "key": "page_size",
                  "value": "50",
                  "description": "Items per page. Default `50`."
                }
              ],
              "variable": []
            },
