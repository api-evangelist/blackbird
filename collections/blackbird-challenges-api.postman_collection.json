          "request": {
            "name": "List challenges",
            "description": {
              "content": "Lists restaurant challenges — reward campaigns a member completes\n(by payment, referrals, dines, or passport milestones) to earn FLY.\nAPI-key auth only; requires the `read:restaurant_challenges` scope.\n",
              "type": "text/plain"
            },
            "url": {
