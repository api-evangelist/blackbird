{
  "opencollection": "1.0.0",
  "info": {
    "name": "Flynet App Specials API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Specials",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List specials",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.staging.blackbird.xyz/flynet/v1/specials",
            "params": [
              {
                "name": "restaurant",
                "value": "14339db3-2e7a-42c4-aa98-4c0fb18679eb",
                "type": "query",
                "description": "Restaurant UUID to list specials for."
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Zero-indexed page number."
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "Items per page. Default `50`."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Lists restaurant specials — limited menu items or offers, each\noptionally carrying a FLY reward and a check-in threshold. API-key\nauth only; requires the `read:restaurant_specials` scope.\n"
        }
      ]
    }
  ],
  "bundled": true
}